{
  "exit": 0,
  "calls": [
    ["secret", "ls"],
    ["ls"],
    ["run", "-d", "--name", "<name>"],
    ["ports", "<name>"],
    ["ports", "<name>", "--publish", "127.0.0.1:<port>:3773"],
    [
      "exec",
      "<name>",
      "--",
      "sh",
      "-c",
      "git config --global user.name \"$(printf %s '<b64:Agent for Test User>')\""
    ],
    [
      "exec",
      "<name>",
      "--",
      "sh",
      "-c",
      "git config --global user.email \"$(printf %s '<b64:test@example.com>')\""
    ],
    ["exec", "<name>", "--", "t3", "pair"]
  ],
  "warnings": ["could not publish <port>:3773 (see: sbx ports <name>)"]
}
