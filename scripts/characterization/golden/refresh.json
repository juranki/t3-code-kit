{
  "exit": 0,
  "calls": [
    ["--no-input", "stop", "<name>"],
    ["--no-input", "secret", "ls"],
    ["--no-input", "ls", "--json"],
    ["--no-input", "run", "-d", "--name", "<name>"],
    ["--no-input", "ports", "<name>"],
    [
      "--no-input",
      "exec",
      "<name>",
      "--",
      "sh",
      "-c",
      "git config --global user.name \"$(printf %s '<b64:Agent for Test User>')\""
    ],
    [
      "--no-input",
      "exec",
      "<name>",
      "--",
      "sh",
      "-c",
      "git config --global user.email \"$(printf %s '<b64:test@example.com>')\""
    ],
    ["--no-input", "exec", "<name>", "--", "t3", "pair"]
  ],
  "warnings": []
}
