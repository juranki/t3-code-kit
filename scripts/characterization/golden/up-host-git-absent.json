{
  "exit": 0,
  "calls": [
    ["--no-input", "secret", "ls"],
    ["--no-input", "ls", "--json"],
    ["--no-input", "create", "--name", "<name>", "-p", "127.0.0.1:<port>:3773", "<kit>"],
    ["--no-input", "run", "-d", "--name", "<name>"],
    [
      "--no-input",
      "exec",
      "<name>",
      "--",
      "sh",
      "-c",
      "git config --global user.name \"$(printf %s '<b64:Agent>')\""
    ],
    [
      "--no-input",
      "exec",
      "<name>",
      "--",
      "sh",
      "-c",
      "git config --global user.email \"$(printf %s '<b64:agent@t3-code-kit>')\""
    ],
    ["--no-input", "exec", "<name>", "--", "t3", "pair"]
  ],
  "warnings": [
    "no user.name/user.email on this host; using Agent <agent@t3-code-kit>.",
    "set them with:  git config --global user.name 'Your Name'"
  ]
}
