#!/bin/sh
# t3-code-kit — tests for the launchers themselves.
#
# `npm run smoke` proves a running sandbox works. This proves the launchers decide
# correctly, on a host that has no sandbox at all: every `sbx` call is answered
# by a stub, so the cases are the ones a real host cannot be talked into.
#
# The secret check is the reason this exists. It shipped a regression where the
# NAME column was matched at the start of the line, and nothing caught it
# because no test ever ran the launchers' own logic. The three outcomes it has
# to tell apart — present, absent, could-not-tell — are asserted below, for both
# launchers, because they are twins and drift is the whole risk.
set -u

SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SELF/.." && pwd)

pass=0
fail=0

ok()   { pass=$((pass + 1)); printf 'ok    %s\n' "$*"; }
no()   { fail=$((fail + 1)); printf 'FAIL  %s\n' "$*"; }

# --- the stub -------------------------------------------------------------
#
# Answers `secret ls` from $STUB_SECRET_OUTPUT and $STUB_SECRET_STATUS. The
# verbs `up` needs (`create`, `run`, `ports`, `ls`) succeed silently, so `up`
# runs to the end and the git-identity assertions can see what it did. Anything
# else fails loudly: a verb the launcher is not expected to call is a surprise
# worth failing on.
STUB_DIR=$(mktemp -d)
trap 'rm -rf "$STUB_DIR"' EXIT

cat > "$STUB_DIR/sbx" <<'STUB'
#!/bin/sh
if [ "$1" = secret ] && [ "$2" = ls ]; then
  printf '%s' "${STUB_SECRET_OUTPUT-}"
  exit "${STUB_SECRET_STATUS-0}"
fi
# `up` asserts the git identity with `exec <name> -- <cmd...>`. The command is
# RUN, not just logged, so the assertion sees the value the sandbox would
# actually end up with - base64 decoding included. Logging the raw argv would
# assert the encoding, not the result, and an encoding bug would pass.
#
# `shift 2` drops `exec` and the sandbox name, leaving `--` at $1.
if [ "$1" = exec ]; then
  shift 2
  [ "$1" = -- ] && shift
  # Run it with git replaced by a recorder that logs the argv it was handed,
  # so `git config --global user.name '<value>'` lands in the log decoded.
  # "$@", not "$*": the argv boundary is the thing under test. Joining with
  # spaces would re-split the base64 command and prove nothing.
  _log=${STUB_EXEC_LOG:-/dev/null}
  STUB_GIT_LOG=$_log "$@" 2>/dev/null
  # $STUB_EXEC_STATUS lets a case exercise the "could not set the identity"
  # warning, which is otherwise unreachable: the happy path always exits 0.
  exit "${STUB_EXEC_STATUS:-0}"
fi
# Only the verbs `up` actually calls. A wider list would let a future launcher
# reach a verb the test never meant to allow and still pass.
case "$1" in
  create|run|ports|ls) exit 0 ;;
esac
echo "stub sbx: unexpected call: $*" >&2
exit 99
STUB
chmod +x "$STUB_DIR/sbx"

# Run a launcher's `up` against the stub and report what it said about the
# secret. `up` is expected to die later on the stub's unexpected-call exit;
# only the secret warning is under test, so the exit code is ignored.
WARNING_TEXT="no 'github' secret on this host: clone/push will fail."

# The host's own git identity is read with `git config --get`, so the stub git
# answers from $STUB_HOST_NAME / $STUB_HOST_EMAIL (unset = not configured, which
# is the exit-1 shape real git uses) and records the sandbox-side config writes.
cat > "$STUB_DIR/git" <<'STUB'
#!/bin/sh
# Sandbox side: `git config --global user.name <value>` - record what it was
# handed, so the test asserts the decoded value, not the encoding.
if [ "$1" = config ] && [ "$2" = --global ]; then
  printf '%s %s\n' "$3" "$4" >>"${STUB_GIT_LOG:-/dev/null}"
  exit 0
fi
# Host side: `git config --get user.name` / `user.email`.
if [ "$1" = config ] && [ "$2" = --get ]; then
  case "$3" in
    user.name)  [ -n "${STUB_HOST_NAME-}" ]  && { printf '%s\n' "$STUB_HOST_NAME";  exit 0; } ;;
    user.email) [ -n "${STUB_HOST_EMAIL-}" ] && { printf '%s\n' "$STUB_HOST_EMAIL"; exit 0; } ;;
  esac
  exit 1
fi
echo "stub git: unexpected call: $*" >&2
exit 99
STUB
chmod +x "$STUB_DIR/git"

# --- bash launcher --------------------------------------------------------

secret_case_bash() {
  _name=$1 _output=$2 _status=$3 _expect=$4

  _err=$(STUB_SECRET_OUTPUT=$_output STUB_SECRET_STATUS=$_status \
         SBX=$STUB_DIR/sbx T3CK_NAME=testprobe \
         sh "$ROOT/bin/t3-code-kit" up testprobe 2>&1 >/dev/null)

  case $_expect in
    warn)
      case $_err in
        *"$WARNING_TEXT"*) ok "bash: $_name — warns" ;;
        *) no "bash: $_name — expected a warning, got: $_err" ;;
      esac ;;
    quiet)
      case $_err in
        *"$WARNING_TEXT"*) no "bash: $_name — warned, must stay quiet: $_err" ;;
        *) ok "bash: $_name — quiet" ;;
      esac ;;
  esac
}

# --- PowerShell launcher --------------------------------------------------

secret_case_ps() {
  _name=$1 _output=$2 _status=$3 _expect=$4

  _err=$(STUB_SECRET_OUTPUT=$_output STUB_SECRET_STATUS=$_status \
         SBX=$STUB_DIR/sbx T3CK_NAME=testprobe \
         pwsh -NoProfile -File "$ROOT/bin/t3-code-kit.ps1" up testprobe 2>&1 >/dev/null)

  case $_expect in
    warn)
      case $_err in
        *"$WARNING_TEXT"*) ok "pwsh: $_name — warns" ;;
        *) no "pwsh: $_name — expected a warning, got: $_err" ;;
      esac ;;
    quiet)
      case $_err in
        *"$WARNING_TEXT"*) no "pwsh: $_name — warned, must stay quiet: $_err" ;;
        *) ok "pwsh: $_name — quiet" ;;
      esac ;;
  esac
}

# --- the cases ------------------------------------------------------------
#
# One table, run against both launchers. Whatever `sbx secret ls` really looks
# like, these are the four situations the check must tell apart.

run_secret_cases() {
  _run=$1

  # Present: a github row in the third column. Silent.
  $_run 'github row present' \
    'SCOPE  TYPE   NAME    SECRET
global api    github  ****' 0 quiet

  # Absent: the listing parsed, and no row names github. Warn.
  $_run 'no github row' \
    'SCOPE  TYPE   NAME        SECRET
global api    anthropic   ****' 0 warn

  # Absent, near miss: github-enterprise is not github. The delimiter guard.
  $_run 'only github-enterprise' \
    'SCOPE  TYPE   NAME               SECRET
global api    github-enterprise  ****' 0 warn

  # Could not tell: sbx failed. Silent — never advise overwriting a credential
  # we could not read.
  $_run 'sbx secret ls fails' '' 1 quiet

  # Could not tell by exit, even though output looked like an absence. The exit
  # code is the signal, not the text.
  $_run 'sbx fails with header output' \
    'SCOPE  TYPE   NAME    SECRET' 1 quiet

  # Absent: exit zero and a header with no rows is a real, empty listing.
  $_run 'header only' 'SCOPE  TYPE   NAME    SECRET' 0 warn

  # Absent: exit zero and no output at all is still a listing we read.
  $_run 'empty output' '' 0 warn
}

printf 'secret check — bash launcher\n'
run_secret_cases secret_case_bash

if command -v pwsh >/dev/null 2>&1; then
  printf '\nsecret check — PowerShell launcher\n'
  run_secret_cases secret_case_ps
else
  printf '\nskipping PowerShell launcher: no pwsh on PATH\n'
fi

# --- git identity ---------------------------------------------------------
#
# `up` must leave the sandbox with `Agent for <host name>` and the host's own
# email, so a sandbox commit is honestly labelled and still links to the
# account. The name is what the user sees; the email is what GitHub matches.
#
# Asserted on the argv that crossed `sbx exec`, not on the launcher's intent:
# the space in "Juhani Ränkimies" and the non-ASCII ä are the whole hazard, and
# a value re-split by a shell would show up here as extra argv words.

# The stub git records `user.name <decoded value>` per write, so the log is
# already in the shape the assertions want. Filtering to config writes keeps a
# stray `t3 pair` or `tail` exec from being read as an identity.
exec_argv() { grep -E '^user\.(name|email) ' "$1" 2>/dev/null; }

identity_case_bash() {
  _name=$1 _host_name=$2 _host_email=$3 _prefix=$4 _want_name=$5 _want_email=$6
  _log=$(mktemp)

  STUB_EXEC_LOG=$_log STUB_HOST_NAME=$_host_name STUB_HOST_EMAIL=$_host_email \
  T3CK_AGENT_NAME_PREFIX=$_prefix \
  PATH="$STUB_DIR:$PATH" SBX=$STUB_DIR/sbx T3CK_NAME=testprobe \
  sh "$ROOT/bin/t3-code-kit" up testprobe >/dev/null 2>&1 || true

  _got_name=$(exec_argv "$_log" | sed -n 's/^user\.name \(.*\)$/\1/p')
  _got_email=$(exec_argv "$_log" | sed -n 's/^user\.email \(.*\)$/\1/p')

  if [ "$_got_name" = "$_want_name" ]; then
    ok "bash: $_name — name is '$_want_name'"
  else
    no "bash: $_name — name: want '$_want_name', got '$_got_name'"
  fi
  if [ "$_got_email" = "$_want_email" ]; then
    ok "bash: $_name — email is '$_want_email'"
  else
    no "bash: $_name — email: want '$_want_email', got '$_got_email'"
  fi
  rm -f "$_log"
}

identity_case_ps() {
  _name=$1 _host_name=$2 _host_email=$3 _prefix=$4 _want_name=$5 _want_email=$6
  _log=$(mktemp)

  STUB_EXEC_LOG=$_log STUB_HOST_NAME=$_host_name STUB_HOST_EMAIL=$_host_email \
  T3CK_AGENT_NAME_PREFIX=$_prefix \
  PATH="$STUB_DIR:$PATH" SBX=$STUB_DIR/sbx T3CK_NAME=testprobe \
  pwsh -NoProfile -File "$ROOT/bin/t3-code-kit.ps1" up testprobe >/dev/null 2>&1 || true

  _got_name=$(exec_argv "$_log" | sed -n 's/^user\.name \(.*\)$/\1/p')
  _got_email=$(exec_argv "$_log" | sed -n 's/^user\.email \(.*\)$/\1/p')

  if [ "$_got_name" = "$_want_name" ]; then
    ok "pwsh: $_name — name is '$_want_name'"
  else
    no "pwsh: $_name — name: want '$_want_name', got '$_got_name'"
  fi
  if [ "$_got_email" = "$_want_email" ]; then
    ok "pwsh: $_name — email is '$_want_email'"
  else
    no "pwsh: $_name — email: want '$_want_email', got '$_got_email'"
  fi
  rm -f "$_log"
}

printf '\ngit identity — bash launcher\n'
# The ordinary case: a host that has configured git. The prefix is added to the
# name; the email passes through untouched so GitHub still links the commit.
identity_case_bash 'host config present' \
  'Juhani Ränkimies' 'juhani@example.com' 'Agent for ' \
  'Agent for Juhani Ränkimies' 'juhani@example.com'
# No host config: the identity must still be honest. "Agent" names no person.
identity_case_bash 'host config absent' \
  '' '' 'Agent for ' 'Agent' 'agent@t3-code-kit'
# The documented opt-out: an empty prefix leaves the bare host name.
identity_case_bash 'prefix overridden to empty' \
  'Juhani Ränkimies' 'juhani@example.com' '' \
  'Juhani Ränkimies' 'juhani@example.com'

# A failed `sbx exec` must warn and let `up` finish, not abort it: the sandbox
# is already created and the server is what the user asked for. The warning is
# the whole of the behaviour, so assert on it.
# Run a launcher's `up` with the given extra env, discarding its output.
run_up_bash() { sh "$ROOT/bin/t3-code-kit" up testprobe; }
run_up_ps()   { pwsh -NoProfile -File "$ROOT/bin/t3-code-kit.ps1" up testprobe; }

exec_failure_case() {
  _run=$1 _label=$2
  _err=$(STUB_EXEC_STATUS=1 STUB_HOST_NAME='Juhani Ränkimies' \
         STUB_HOST_EMAIL='juhani@example.com' \
         PATH="$STUB_DIR:$PATH" SBX=$STUB_DIR/sbx T3CK_NAME=testprobe \
         $_run 2>&1 >/dev/null)
  case $_err in
    *'could not set the git identity'*)
      ok "$_label: failed exec warns" ;;
    *) no "$_label: failed exec — expected a warning, got: $_err" ;;
  esac
}

# `up` re-asserts on every run, so a hand-edited identity is corrected rather
# than respected. Asserted by running `up` twice against one log and checking
# the second run wrote the identity again.
reassert_case() {
  _run=$1 _label=$2
  _log=$(mktemp)
  for _pass in 1 2; do
    STUB_EXEC_LOG=$_log STUB_HOST_NAME='Juhani Ränkimies' \
    STUB_HOST_EMAIL='juhani@example.com' \
    PATH="$STUB_DIR:$PATH" SBX=$STUB_DIR/sbx T3CK_NAME=testprobe \
    $_run >/dev/null 2>&1 || true
  done
  _writes=$(exec_argv "$_log" | grep -c '^user\.name Agent for Juhani Ränkimies$' || true)
  if [ "$_writes" -eq 2 ]; then
    ok "$_label: second up re-asserts the identity"
  else
    no "$_label: expected 2 identity writes across two ups, got $_writes"
  fi
  rm -f "$_log"
}

printf '\ngit identity — failure and re-assert\n'
exec_failure_case run_up_bash 'bash'
reassert_case run_up_bash 'bash'

if command -v pwsh >/dev/null 2>&1; then
  printf '\ngit identity — PowerShell launcher\n'
  identity_case_ps 'host config present' \
    'Juhani Ränkimies' 'juhani@example.com' 'Agent for ' \
    'Agent for Juhani Ränkimies' 'juhani@example.com'
  identity_case_ps 'host config absent' \
    '' '' 'Agent for ' 'Agent' 'agent@t3-code-kit'
  identity_case_ps 'prefix overridden to empty' \
    'Juhani Ränkimies' 'juhani@example.com' '' \
    'Juhani Ränkimies' 'juhani@example.com'

  printf '\ngit identity — failure and re-assert (PowerShell)\n'
  exec_failure_case run_up_ps 'pwsh'
  reassert_case run_up_ps 'pwsh'
fi

printf '\n%d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
