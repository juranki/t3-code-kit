#!/bin/sh
# Acceptance test for t3-code-kit. This is what "it works" means.
#
#   bin/smoke [sandbox-name]
#
# Leaves the sandbox running unless SMOKE_DOWN=1.
#
# ⚠️ Step 6 spends real model tokens. Set SMOKE_SKIP_AGENT=1 to skip it.
set -u

SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SELF/.." && pwd)
KIT_BIN="$SELF/t3-code-kit"

SBX=${SBX:-sbx}
HOST_PORT=${T3CK_PORT:-3773}
NAME=${1:-${T3CK_NAME:-t3ck-smoke}}
REPO=${SMOKE_REPO:-https://github.com/juranki/t3-code-kit}

pass=0
fail=0
skip=0

ok()   { pass=$((pass + 1)); printf '  PASS  %s\n' "$*"; }
no()   { fail=$((fail + 1)); printf '  FAIL  %s\n' "$*"; }
meh()  { skip=$((skip + 1)); printf '  SKIP  %s\n' "$*"; }
head_() { printf '\n== %s\n' "$*"; }

in_sbx() { $SBX exec "$NAME" -- "$@" 2>&1; }

# ---------------------------------------------------------------- static
head_ "static checks"

for f in kit/t3-code.yaml kit/t3-code.dockerfile kit/serve.sh kit/skills.txt kit/skills.sh policy/allow.txt policy/install.txt; do
  [ -f "$ROOT/$f" ] && ok "$f exists" || no "$f missing"
done

# The policy mirrors must not promise anything the descriptor denies: the
# descriptor is normative, these files are the readable copies. allow.txt is
# runtime egress, install.txt is build-time egress; both are checked.
if [ -f "$ROOT/policy/allow.txt" ] && [ -f "$ROOT/kit/t3-code.yaml" ]; then
  missing=""
  for mirror in "$ROOT/policy/allow.txt" "$ROOT/policy/install.txt"; do
    [ -f "$mirror" ] || continue
    while IFS= read -r host; do
      case "$host" in ''|\#*) continue ;; esac
      grep -q -- "$host" "$ROOT/kit/t3-code.yaml" || missing="$missing $host"
    done <"$mirror"
  done
  [ -z "$missing" ] && ok "policy mirrors match the descriptor" \
    || no "in a policy mirror but not in kit/t3-code.yaml:$missing"
fi

# `t3-code-kit policy` prints policy/allow.txt as "egress allowed at runtime",
# so a build-time host in that file is a permission an agent acts on and then
# gets a 403 for. The two lists must not be merged.
if [ -f "$ROOT/policy/allow.txt" ]; then
  install_hosts=" nodejs.org dl.google.com pypi.org files.pythonhosted.org "
  leaked=""
  while IFS= read -r host; do
    case "$host" in ''|\#*) continue ;; esac
    case "$install_hosts" in *" $host "*) leaked="$leaked $host" ;; esac
  done <"$ROOT/policy/allow.txt"
  [ -z "$leaked" ] && ok "policy/allow.txt lists runtime egress only" \
    || no "install-time hosts in policy/allow.txt (they belong in policy/install.txt):$leaked"
fi

# ---------------------------------------------------------------- runtime
head_ "sandbox lifecycle"

T3CK_NAME=$NAME "$KIT_BIN" up >/tmp/t3ck-smoke-up.log 2>&1
if [ $? -eq 0 ]; then
  ok "up succeeded"
else
  no "up failed; see /tmp/t3ck-smoke-up.log"
  printf '\n%s\n' "$(cat /tmp/t3ck-smoke-up.log)" >&2
  exit 1
fi

head_ "reachability"

if curl -fsS -o /dev/null --max-time 5 "http://localhost:$HOST_PORT/"; then
  ok "http://localhost:$HOST_PORT/ answers"
else
  no "http://localhost:$HOST_PORT/ does not answer"
fi

pair=$(T3CK_NAME=$NAME "$KIT_BIN" url 2>/dev/null || true)
case "$pair" in
  http://localhost:*'/pair#token='*)
    ok "pairing URL minted and rewritten to localhost"
    if curl -fsS -o /dev/null --max-time 5 "${pair%%#*}"; then
      ok "pairing page answers"
    else
      no "pairing page does not answer"
    fi
    ;;
  *) no "no usable pairing URL (got: ${pair:-nothing})" ;;
esac

head_ "toolchain inside the sandbox"

for cmd in "t3 --version" "pi --version" "git --version" "mise --version"; do
  if in_sbx sh -c "$cmd" >/dev/null; then ok "$cmd"; else no "$cmd"; fi
done

# The baked versions are the descriptor's build-arg defaults — read them here
# rather than keeping a second copy that drifts from kit/t3-code.yaml.
arg_default() {
  awk -v key="$1:" '$1 == key { found = 1; next }
                     found && $1 == "default:" { gsub(/"/, "", $2); print $2; exit }' \
    "$ROOT/kit/t3-code.yaml"
}

# mise's shims, not the base image's node 24 / go / python. `sbx exec` runs a
# non-interactive shell, which is exactly where `mise activate` would never
# have fired — so this is the assertion that catches a PATH-ordering
# regression here, instead of it surfacing later as "the agent used the wrong
# node".
SHIMS=/home/agent/.local/share/mise/shims
shim_report=$(in_sbx sh -c '
  echo "node=$(node --version 2>&1 | sed s/^v//)"
  echo "go=$(go version 2>&1 | sed "s/^go version go\([0-9][0-9.]*\).*/\1/")"
  echo "python=$(python --version 2>&1 | sed "s/^Python //")"
  echo "node_path=$(command -v node)"
  echo "go_path=$(command -v go)"
  echo "python_path=$(command -v python)"
' | tr -d '\r')

shim_field() { printf '%s\n' "$shim_report" | sed -n "s/^$1=//p" | head -1; }

check_shim() {
  tool=$1 want=$2
  got=$(shim_field "$tool")
  path=$(shim_field "${tool}_path")
  if [ -z "$want" ]; then
    no "$tool: no ${tool}Version default in kit/t3-code.yaml"
  elif [ "$path" != "$SHIMS/$tool" ]; then
    no "$tool resolves to ${path:-nothing}, not the mise shim ($SHIMS/$tool)"
  elif [ "$got" != "$want" ]; then
    no "$tool reports ${got:-nothing}, want $want (the baked version)"
  else
    ok "$tool $got through the mise shim"
  fi
}

check_shim node "$(arg_default nodeVersion)"
check_shim go "$(arg_default goVersion)"
check_shim python "$(arg_default pythonVersion)"

# Java is the base image's OpenJDK 21, not mise's: mise-java.jdx.dev is not in
# the allowlist and the base image already carries a JDK. This asserts the PATH
# append actually reaches it.
java_first=$(in_sbx sh -c 'java -version' | tr -d '\r' | head -1)
case "$java_first" in
  *'openjdk version "21'*) ok "java -version is the base image's OpenJDK 21" ;;
  *) no "java -version is not OpenJDK 21: ${java_first:-nothing}" ;;
esac

# mise pulls ca-certificates-bundle, which ships its own copy of
# /etc/ssl/certs/ca-certificates.crt. Without --force-confold dpkg stops at the
# conffile prompt and leaves both packages in state iU: mise still runs, but
# the next apt operation fails. dpkg --audit is the assertion that the flag is
# there; replacing the bundle instead shows up as a TLS failure in the egress
# check below.
audit=$(in_sbx sh -c 'echo "audit=$(dpkg --audit 2>&1 | tr "\n" " ")"' \
          | tr -d '\r' | sed -n 's/^audit=//p' | head -1)
if [ -z "$audit" ]; then
  ok "dpkg --audit is clean"
else
  no "dpkg --audit reports unconfigured packages: $audit"
fi

if in_sbx sh -c 'mountpoint -q /home/agent/workspace' >/dev/null; then
  ok "/home/agent/workspace is a volume, not a host mount"
else
  no "/home/agent/workspace is not a volume"
fi

# The UI's terminal is whatever t3 spawns from the server's $SHELL, and the
# platform starts the workload with SHELL=/bin/sh — dash, which has no
# readline: no history, no completion, no prompt colors. serve.sh exports bash.
# Read the *running* server's environment, not serve.sh: the failure this
# catches is a server that started before the export existed.
server_shell=$(in_sbx sh -c 'tr "\0" "\n" < /proc/$(pgrep -f "^t3 serve" | head -1)/environ 2>/dev/null | sed -n "s/^SHELL=//p"' \
                 | tr -d '\r' | head -1)
if [ "$server_shell" = /bin/bash ]; then
  ok "t3 serve runs with SHELL=/bin/bash (the terminal has history and completion)"
else
  no "t3 serve has SHELL=${server_shell:-unknown}: the UI terminal falls back to dash"
fi

# Skills are baked into the image, and the Dockerfile already asserts the
# count against kit/skills.txt. This is the other failure: an image built
# before skills were baked in, or a RUN that never executed.
manifest="$ROOT/kit/skills.txt"
want=$(sh "$ROOT/kit/skills.sh" count "$manifest" 2>/dev/null || true)
# A sentinel, not a bare number: sbx's own stderr is merged in, so a stray
# digit in an error message must not be read as the count.
have=$(in_sbx sh -c 'echo "skills=$(ls -1 /home/agent/.agents/skills 2>/dev/null | wc -l | tr -d " ")"' \
         | tr -d '\r' | sed -n 's/^skills=\([0-9][0-9]*\)$/\1/p' | head -1 || true)
if [ "${want:-0}" -gt 0 ] && [ "${have:-0}" -eq "${want:-0}" ]; then
  ok "$want skills baked in, kit/skills.txt agrees"
else
  no "skills: ${have:-0} baked in, ${want:-0} in kit/skills.txt"
fi

head_ "model catalog"

# serve.sh refreshes pi's catalog before t3 serve. pi keeps the refreshed
# catalog in <agent-dir>/models-store.json; a non-empty one written after this
# start's `t3 serve starting` marker means the refresh ran and fetched, rather
# than the sandbox falling back to the catalog baked into the image. Compare
# against the marker, not the log's mtime: tee appends t3's output after the
# catalog write, so the live log is always newer than the store.
catalog_out=$(in_sbx sh -c '
  log="${T3CODE_HOME:-$HOME/.t3}/serve.log"
  store="$HOME/.pi/agent/models-store.json"
  started=$(sed -n "s/^--- \([^ ]*\) t3 serve starting$/\1/p" "$log" 2>/dev/null | tail -1)
  started_epoch=0
  [ -n "$started" ] && started_epoch=$(date -d "$started" +%s 2>/dev/null || echo 0)
  store_epoch=$(stat -c %Y "$store" 2>/dev/null || echo 0)
  if [ -s "$store" ] && grep -q "\"models\"" "$store" && grep -q "\"id\"" "$store" && [ "$store_epoch" -ge "$started_epoch" ]; then
    echo "pi_catalog=fresh"
  elif [ -s "$store" ] && grep -q "\"models\"" "$store" && grep -q "\"id\"" "$store"; then
    echo "pi_catalog=stale"
  else
    echo "pi_catalog=missing"
  fi
' | tr -d '\r')
pi_catalog=$(printf '%s\n' "$catalog_out" | sed -n 's/^pi_catalog=//p' | head -1)
case "$pi_catalog" in
  fresh)
    ok "pi's model catalog refreshed at startup"
    ;;
  stale)
    no "pi's model catalog is older than this start — the startup refresh did not run (see: t3-code-kit logs $NAME)"
    ;;
  *)
    no "pi's model catalog is missing — the startup refresh did not fetch one (blocked pi.dev or no provider credential; see: t3-code-kit logs $NAME)"
    ;;
esac

head_ "egress and credentials"

if in_sbx git ls-remote --exit-code "$REPO" HEAD >/dev/null; then
  ok "git ls-remote $REPO (network + github credential)"
else
  no "git ls-remote $REPO — check policy/allow.txt and: sbx secret set github"
fi

head_ "agent round-trip"

if [ "${SMOKE_SKIP_AGENT:-0}" = 1 ]; then
  meh "pi prompt skipped (SMOKE_SKIP_AGENT=1)"
elif in_sbx sh -c "pi -p 'Reply with exactly: OK' --no-tools --no-session" | grep -q OK; then
  ok "pi answered through its provider"
else
  no "pi could not answer — check the provider key and its egress entry"
fi

# ---------------------------------------------------------------- teardown
head_ "summary"
printf '  %s passed, %s failed, %s skipped\n' "$pass" "$fail" "$skip"

if [ "${SMOKE_DOWN:-0}" = 1 ]; then
  T3CK_NAME=$NAME "$KIT_BIN" down >/dev/null 2>&1 && printf '  sandbox stopped\n'
else
  printf '  sandbox %s left running (SMOKE_DOWN=1 to stop it)\n' "$NAME"
fi

[ "$fail" -eq 0 ] || exit 1
