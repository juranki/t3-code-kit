#!/bin/sh
# t3-code-kit — run T3 Code + pi inside a Docker Sandbox and drive it from a
# browser on the host.
#
# Six verbs, each a few lines of `sbx`. Anything else, type `sbx` directly:
# a launcher that reimplements an Early-Access CLI rots against it.
set -eu

SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SELF/.." && pwd)
KIT="$ROOT/kit"
POLICY="$ROOT/policy/allow.txt"

SBX=${SBX:-sbx}
# Build the Kit in a builder sandbox, not with the host's Docker Buildx. The
# whole promise here is that the host needs no Docker Engine; without this, a
# host with Docker Desktop installed but not running fails with
# "open //./pipe/dockerDesktopLinuxEngine: The system cannot find the file".
SBX_KIT_BUILDER=${SBX_KIT_BUILDER:-sandbox}
export SBX_KIT_BUILDER
HOST_PORT=${T3CK_PORT:-3773}
CONTAINER_PORT=3773
READY_TIMEOUT=${T3CK_READY_TIMEOUT:-120}
# Prepended to the host's git user.name, because a sandbox commit is made by an
# agent and should say so. Set it to the empty string to use the bare host
# name. See docs/adr/0002-git-identity-from-host.md.
AGENT_NAME_PREFIX=${T3CK_AGENT_NAME_PREFIX-Agent for }
# The last-resort identity when the host has no git config at all. Names no
# person, which is the point: the alternative is impersonating one.
FALLBACK_NAME=Agent
FALLBACK_EMAIL=agent@t3-code-kit

die() { printf 't3-code-kit: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*" >&2; }

sandbox_name() {
  n=${1:-${T3CK_NAME:-}}
  [ -n "$n" ] || die "no sandbox name: pass one, or set T3CK_NAME"
  printf '%s' "$n"
}

exists() {
  $SBX ls 2>/dev/null | grep -qw "$1"
}

require_secret() {
  # The check has three outcomes, not two: present, absent, and could-not-tell.
  # Only 'absent' may warn. A non-zero exit from `sbx secret ls` means we never
  # saw the listing, so claiming the secret is missing would invite the user to
  # overwrite a working credential - stay quiet instead.
  #
  # `sbx secret ls` prints SCOPE TYPE NAME SECRET, so the name is the third
  # column - not the start of the line. Matching '^github' never fired on a
  # correctly configured host and warned on every run.
  status=0
  listing=$($SBX secret ls 2>/dev/null) || status=$?
  [ "$status" -eq 0 ] || return 0

  # Exit zero means the listing is trustworthy, so no matching row is a real
  # absence. The delimiter guard keeps 'github-enterprise' from counting.
  # `if`, not `&&`, so a non-matching grep cannot trip `set -e`.
  if printf '%s\n' "$listing" \
       | grep -qE '^[[:space:]]*[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+github([[:space:]]|$)'; then
    return 0
  fi

  warn "no 'github' secret on this host: clone/push will fail."
  warn "set one with:  sbx secret set github"
}

# The host's git identity, read once. `git config --get` exits 1 when the key
# is unset, which is the normal "host has no config" case and not an error, so
# the status is swallowed rather than propagated.
host_git_name()  { git config --get user.name  2>/dev/null || true; }
host_git_email() { git config --get user.email 2>/dev/null || true; }

# Leave the sandbox with a git identity, so a commit made in it is authored
# honestly and still links to the user's account.
#
# The value crosses `sbx exec` as its own argv word, never through `sh -c`:
# "Juhani Ränkimies" has a space and a non-ASCII ä, and a shell in the middle
# would re-split or mangle both. `git config` writes bytes, so the host's UTF-8
# lands as-is.
#
# Overwritten on every `up` rather than only when unset. A wrong identity that
# a previous run left behind is exactly the bug this fixes, so "already set"
# cannot mean "leave it alone" - the printed line is what makes the overwrite
# visible instead of silent.
ensure_git_identity() {
  n=$1
  host_name=$(host_git_name)
  host_email=$(host_git_email)

  # Judged before the fallbacks are substituted, or the warning can never
  # fire: after the substitution both values are non-empty by construction.
  host_configured=0
  if [ -n "$host_name" ] && [ -n "$host_email" ]; then
    host_configured=1
  fi

  if [ -n "$host_name" ]; then
    name="$AGENT_NAME_PREFIX$host_name"
  else
    name=$FALLBACK_NAME
  fi
  [ -n "$host_email" ] || host_email=$FALLBACK_EMAIL

  say "git identity: $name <$host_email>"
  if [ "$host_configured" -eq 0 ]; then
    warn "no user.name/user.email on this host; using $name <$host_email>."
    warn "set them with:  git config --global user.name 'Your Name'"
  fi

  # A failure here is not fatal to `up`: the sandbox is already created and the
  # server is what the user asked for. Warn, the way require_secret does.
  set_sandbox_git_config "$n" user.name  "$name"
  set_sandbox_git_config "$n" user.email "$host_email"
}

# The value is passed base64-encoded and decoded inside the sandbox, not as a
# plain argv word.
#
# This shell is byte-transparent, so a plain argv word would work here. The
# PowerShell twin is not: on Windows it converts an outbound argument to a
# native process through the process's ANSI/OEM code page, so `ä` does not
# survive the trip and the sandbox stores the mojibake as real characters -
# which no locale fix downstream can undo. Base64 is pure ASCII, so it survives
# every encoding layer by construction, and using it in both keeps the twins
# byte-identical in behaviour rather than merely similar.
set_sandbox_git_config() {
  _n=$1 _key=$2 _value=$3
  _b64=$(printf '%s' "$_value" | base64 | tr -d '\n')
  $SBX exec "$_n" -- sh -c "git config --global $_key \"\$(printf %s '$_b64' | base64 -d)\"" \
    || warn "could not set the git identity in '$_n'; commits will carry an auto-generated author"
}

print_policy() {
  say ""
  say "egress allowed at runtime (everything else denied):"
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$POLICY" | grep -v '^$' | sed 's/^/  /'
  say ""
}

wait_ready() {
  n=$1
  i=0
  say "waiting for the server on http://localhost:$HOST_PORT/ ..."
  while [ "$i" -lt "$READY_TIMEOUT" ]; do
    if curl -fsS -o /dev/null --max-time 2 "http://localhost:$HOST_PORT/" 2>/dev/null; then
      say "server is up."
      return 0
    fi
    i=$((i + 2))
    sleep 2
  done
  warn "no answer after ${READY_TIMEOUT}s. Check: t3-code-kit logs $n"
  return 1
}

ensure_port() {
  if $SBX ports "$1" 2>/dev/null | grep -q ":$HOST_PORT"; then
    return 0
  fi
  $SBX ports "$1" --publish "127.0.0.1:$HOST_PORT:$CONTAINER_PORT" \
    || warn "could not publish $HOST_PORT:$CONTAINER_PORT (see: sbx ports $1)"
}

cmd_up() {
  n=$(sandbox_name "${1:-}")
  require_secret
  if exists "$n"; then
    say "sandbox '$n' exists; starting it."
    # A restart keeps the image the sandbox was created from. Changing
    # anything under kit/ needs `rebuild`, not `up`.
    say "note: this reuses the sandbox's existing image; run 't3-code-kit rebuild $n' after editing kit/."
    $SBX run -d --name "$n" || die "could not start sandbox '$n'"
    # --publish is ignored on re-attach, so the mapping must be re-asked.
    ensure_port "$n"
  else
    # `create`, not `run`: `sbx run` always mounts a workspace, and with no
    # path argument it mounts the *current directory*. `sbx create` with no
    # path is the mountless form — the agent works in the container's own
    # filesystem, which is the whole point here.
    $SBX create --name "$n" -p "127.0.0.1:$HOST_PORT:$CONTAINER_PORT" "$KIT" \
      || die "could not create sandbox '$n'"
    $SBX run -d --name "$n" || die "could not start sandbox '$n'"
  fi
  # create published via -p already; asking again is a 409 Conflict.
  ensure_git_identity "$n"
  print_policy
  wait_ready "$n" || true
  cmd_url "$n"
}

cmd_url() {
  n=$(sandbox_name "${1:-}")
  raw=$($SBX exec "$n" -- t3 pair 2>/dev/null \
        | grep -o 'http://[^[:space:]]*#token=[A-Za-z0-9]*' | head -1 || true)
  if [ -z "$raw" ]; then
    raw=$($SBX exec "$n" -- sh -c \
          'grep -o "Pairing URL: http://[^[:space:]]*" "${T3CODE_HOME:-/home/agent/.t3}/serve.log" 2>/dev/null | tail -1 | cut -d" " -f3' \
          2>/dev/null || true)
  fi
  [ -n "$raw" ] || die "no pairing URL: is the server up? try: t3-code-kit logs $n"
  # t3 prints the outbound interface address, which the host browser cannot
  # reach. Rewrite it to the published loopback port.
  token=${raw##*#token=}
  printf 'http://localhost:%s/pair#token=%s\n' "$HOST_PORT" "$token"
}

cmd_logs() {
  n=$(sandbox_name "${1:-}")
  lines=${2:-200}
  if ! $SBX exec "$n" -- tail -n "$lines" /home/agent/.t3/serve.log 2>/dev/null; then
    warn "no /home/agent/.t3/serve.log in '$n' — serve.sh never started."
    warn "falling back to the runtime's startup-hook log:"
    $SBX exec "$n" -- tail -n "$lines" /var/log/sbx-kit-startup.log 2>/dev/null \
      || warn "no startup-hook log either: the lifecycle@1 hook did not run."
  fi
}

cmd_shell() {
  n=$(sandbox_name "${1:-}")
  $SBX exec -it "$n" -- bash || $SBX attach "$n"
}

cmd_refresh() {
  n=$(sandbox_name "${1:-}")
  say "restarting '$n'; serve.sh refreshes the model catalog on every start"
  $SBX stop "$n" || die "could not stop '$n'"
  cmd_up "$n"
}

cmd_down() {
  n=$(sandbox_name "${1:-}")
  $SBX stop "$n"
}

cmd_rebuild() {
  n=$(sandbox_name "${1:-}")
  say "recreating '$n' from a freshly built image; repos and t3 state survive on their volumes."
  $SBX rm --force "$n" || true
  cmd_up "$n"
}

cmd_nuke() {
  n=$(sandbox_name "${1:-}")
  say "destroying '$n' and its volumes. This loses every repo and all t3 state."
  $SBX rm --force "$n" || true
  # Volume names are the runtime's business, not ours: list and match.
  vols=$($SBX volume ls 2>/dev/null | grep -- "$n" | awk '{print $1}' || true)
  [ -n "$vols" ] || warn "no volume matched '$n'; check with: sbx volume ls"
  for v in $vols; do
    say "  removing volume $v"
    $SBX volume rm "$v" || warn "could not remove volume $v"
  done
  say "done."
}

cmd_policy() {
  print_policy
}

usage() {
  cat <<'EOF'
usage: t3-code-kit <verb> [sandbox-name]

  up       create or start the sandbox, publish the port, print the pairing URL
  url      print the pairing URL for a running sandbox
  logs     tail the server log inside the sandbox
  shell    open a bash shell inside the sandbox
  refresh  restart, which also refreshes the model catalog
  down     stop the sandbox (volumes and repos survive)
  rebuild  recreate from a freshly built image; repos and t3 state survive
  nuke     destroy the sandbox's data and remove it (volumes stay allocated, empty)
  policy   print the runtime egress allowlist

The sandbox name defaults to $T3CK_NAME. Host port defaults to $T3CK_PORT
(3773). The sbx binary defaults to $SBX.
EOF
}

verb=${1:-}
[ -n "$verb" ] || { usage; exit 2; }
shift || true

case "$verb" in
  up)      cmd_up "$@" ;;
  url)     cmd_url "$@" ;;
  logs)    cmd_logs "$@" ;;
  shell)   cmd_shell "$@" ;;
  refresh) cmd_refresh "$@" ;;
  down)    cmd_down "$@" ;;
  rebuild) cmd_rebuild "$@" ;;
  nuke)    cmd_nuke "$@" ;;
  policy)  cmd_policy ;;
  -h|--help|help) usage ;;
  *) die "unknown verb '$verb' (try: t3-code-kit --help)" ;;
esac
