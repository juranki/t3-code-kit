{
  "name": "t3-code-kit",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "up": "node apps/cli/src/bin.ts up",
    "url": "node apps/cli/src/bin.ts url",
    "logs": "node apps/cli/src/bin.ts logs",
    "shell": "node apps/cli/src/bin.ts shell",
    "refresh": "node apps/cli/src/bin.ts refresh",
    "down": "node apps/cli/src/bin.ts down",
    "rebuild": "node apps/cli/src/bin.ts rebuild",
    "nuke": "node apps/cli/src/bin.ts nuke",
    "policy": "node apps/cli/src/bin.ts policy",
    "doctor": "node apps/cli/src/bin.ts doctor",
    "help": "node apps/cli/src/bin.ts help",
    "smoke": "node scripts/smoke.ts",
    "prune:builder": "sbx --no-input exec sbx-kit-builder docker buildx prune --builder sbx-builder --all --force",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@types/node": "26.6.6",
    "typescript": "npm:@tsc-rs/typescript@0.8.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "effect": "4.1.2",
    "typescript": "npm:@tsc-rs/typescript@0.8.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "26.13.0"
  }
}
